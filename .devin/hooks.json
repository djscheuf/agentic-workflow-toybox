{
  "PreToolUse": [
    {
      "matcher": "edit|write",
      "hooks": [
        {
          "type": "command",
          "command": "bash .devin/scripts/verify-secrets.sh --scope=staged"
        }
      ]
    },
    {
      "matcher":"read",
      "hooks": [
        {
          "type": "command",
          "command": "bash .devin/scripts/protect-secrets.sh"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "edit|write",
      "hooks": [
        {
          "type": "command",
          "command": "bash .devin/scripts/post-edit-verify-skill.sh"
        },
        {
          "type": "command",
          "command": "bash .devin/scripts/validate-json-yaml.sh",
          "timeout": 5
        }
      ]
    }
  ]
}
